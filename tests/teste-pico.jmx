          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Escolhe voo aleatorio" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Escolhe aleatoriamente UM dos voos retornados, mantendo flight/price/airline da mesma linha
int total = (vars.get('flight_matchNr') ?: '0') as int
if (total &gt; 0) {
    int i = java.util.concurrent.ThreadLocalRandom.current().nextInt(total) + 1
    vars.put('flight',  vars.get('flight_'  + i))
    vars.put('price',   vars.get('price_'   + i))
    vars.put('airline', vars.get('airline_' + i))
} else {
    prev.setSuccessful(false)
    prev.setResponseMessage('Nenhum voo retornado para ' + vars.get('fromPort') + ' -&gt; ' + vars.get('toPort'))
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
