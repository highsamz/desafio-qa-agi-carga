        <boolProp name="CookieManager.clearEachIteration">true</boolProp>
        <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
      </CookieManager>
      <hashTree/>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Massa - Rotas (origem/destino)" enabled="true">
        <stringProp name="delimiter">,</stringProp>
        <stringProp name="fileEncoding">UTF-8</stringProp>
        <stringProp name="filename">../data/rotas.csv</stringProp>
        <boolProp name="ignoreFirstLine">true</boolProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="variableNames">fromPort,toPort</stringProp>
      </CSVDataSet>
      <hashTree/>
      <OpenModelThreadGroup guiclass="OpenModelThreadGroupGui" testclass="OpenModelThreadGroup" testname="Compra de passagem - Teste de Pico" enabled="true">
        <elementProp name="ThreadGroup.main_controller" elementType="OpenModelThreadGroupController"/>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <stringProp name="OpenModelThreadGroup.schedule">rate(0/min) even_arrivals(30 s) rate(${__P(rate_base,375)}/min) even_arrivals(${__P(base,2)} min) rate(${__P(rate_base,375)}/min) even_arrivals(10 s) rate(${__P(rate_pico,3780)}/min) even_arrivals(${__P(pico,3)} min) rate(${__P(rate_pico,3780)}/min) even_arrivals(10 s) rate(${__P(rate_base,375)}/min) even_arrivals(${__P(recuperacao,3)} min) rate(${__P(rate_base,375)}/min) even_arrivals(30 s) rate(0/min) pause(30 s)</stringProp>
      </OpenModelThreadGroup>
